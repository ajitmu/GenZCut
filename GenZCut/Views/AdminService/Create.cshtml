@model GenZCut.Models.Admin.AdminServiceViewModel

@{
    ViewData["Title"] = "Add New Service";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Add New Service</h2>

        <a asp-controller="AdminService"
           asp-action="Index"
           class="btn btn-secondary">
            Back to Services
        </a>
    </div>

    <div class="card shadow-sm">

        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Service Information</h5>
        </div>

        <div class="card-body">

            <form asp-controller="AdminService"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="row">

                    <!-- Service Name -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Name" class="form-label"></label>

                        <input asp-for="Name"
                               class="form-control"
                               placeholder="Enter service name" />

                        <span asp-validation-for="Name"
                              class="text-danger"></span>
                    </div>

                    <!-- Price -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Price" class="form-label"></label>

                        <div class="input-group">
                            <span class="input-group-text">₹</span>

                            <input asp-for="Price"
                                   type="number"
                                   step="0.01"
                                   min="0.01"
                                   class="form-control"
                                   placeholder="Enter price" />
                        </div>

                        <span asp-validation-for="Price"
                              class="text-danger"></span>
                    </div>

                    <!-- Duration -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="DurationMinutes"
                               class="form-label"></label>

                        <input asp-for="DurationMinutes"
                               type="number"
                               min="15"
                               max="240"
                               class="form-control"
                               placeholder="Duration in minutes" />

                        <span asp-validation-for="DurationMinutes"
                              class="text-danger"></span>
                    </div>

                    <!-- Barber ID -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="BarberId" class="form-label"></label>

                        <input asp-for="BarberId"
                               type="number"
                               class="form-control"
                               placeholder="Enter barber ID" />

                        <span asp-validation-for="BarberId"
                              class="text-danger"></span>
                    </div>

                    <!-- Description -->
                    <div class="col-md-12 mb-3">
                        <label asp-for="Description"
                               class="form-label"></label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Describe this service..."></textarea>

                        <span asp-validation-for="Description"
                              class="text-danger"></span>
                    </div><!-- Active Status -->
                    <div class="col-md-12 mb-3">
                        <div class="form-check">
                            <input asp-for="IsActive"
                                   class="form-check-input" />

                            <label asp-for="IsActive"
                                   class="form-check-label"></label>
                        </div>
                    </div>

                </div>

                <hr />

                <button type="submit" class="btn btn-success">
                    Save Service
                </button>

                <a asp-controller="AdminService"
                   asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}