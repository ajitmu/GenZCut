@model GenZCut.Models.Admin.AdminServiceViewModel

@{
    ViewData["Title"] = "Service Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Service Details</h2>

        <a asp-controller="AdminService"
           asp-action="Index"
           class="btn btn-secondary">
            Back to Services
        </a>
    </div>

    <div class="card shadow-sm">

        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Service Information</h5>
        </div>

        <div class="card-body">

            <dl class="row">

                <dt class="col-sm-4">Service ID</dt>
                <dd class="col-sm-8">@Model.Id</dd>

                <dt class="col-sm-4">Service Name</dt>
                <dd class="col-sm-8">@Model.Name</dd>

                <dt class="col-sm-4">Description</dt>
                <dd class="col-sm-8">
                    @(Model.Description ?? "No description available")
                </dd>

                <dt class="col-sm-4">Price</dt>
                <dd class="col-sm-8">
                    ₹@Model.Price.ToString("N2")
                </dd>

                <dt class="col-sm-4">Duration</dt>
                <dd class="col-sm-8">
                    @Model.DurationMinutes minutes
                </dd>

                <dt class="col-sm-4">Barber ID</dt>
                <dd class="col-sm-8">@Model.BarberId</dd>

                <dt class="col-sm-4">Barber Name</dt>
                <dd class="col-sm-8">
                    @(Model.BarberName ?? "Not Assigned")
                </dd>

                <dt class="col-sm-4">Total Bookings</dt>
                <dd class="col-sm-8">@Model.TotalBookings</dd>

                <dt class="col-sm-4">Service Status</dt>
                <dd class="col-sm-8">
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </dd>

            </dl>

        </div>

        <div class="card-footer bg-white">

            <a asp-controller="AdminService"
               asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-warning">
                Edit Service
            </a>

            <a asp-controller="AdminService"
               asp-action="Index"
               class="btn btn-secondary">
                Back
            </a>

        </div>

    </div>

</div>