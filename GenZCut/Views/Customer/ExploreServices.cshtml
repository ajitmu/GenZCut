@{
    ViewData["Title"] = "Explore Grooming Services";
}

<style>
    .services-hero {
        background: linear-gradient(135deg, #141414 0%, #242424 100%);
        color: #ffffff;
        padding: 55px 16px 65px;
        text-align: center;
    }

    .hero-eyebrow {
        display: inline-block;
        background: rgba(201, 162, 39, 0.16);
        color: #e5c158;
        border: 1px solid rgba(201, 162, 39, 0.35);
        font-size: 11.5px;
        font-weight: 700;
        letter-spacing: 1.2px;
        text-transform: uppercase;
        padding: 5px 14px;
        border-radius: 999px;
        margin-bottom: 14px;
    }

    .services-hero h1 {
        font-size: 36px;
        font-weight: 800;
        letter-spacing: -0.6px;
        margin-bottom: 10px;
    }

    .services-hero p {
        color: #b8b8b8;
        max-width: 560px;
        margin: 0 auto 28px;
        font-size: 15px;
    }

    .search-filter-bar {
        max-width: 780px;
        margin: 0 auto;
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        justify-content: center;
    }

    .service-search-input {
        flex: 1 1 280px;
        max-width: 380px;
        padding: 12px 18px;
        border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, 0.18);
        background: rgba(255, 255, 255, 0.08);
        color: #ffffff;
        font-size: 14px;
        outline: none;
    }

        .service-search-input::placeholder {
            color: #a0a0a0;
        }

        .service-search-input:focus {
            border-color: #c9a227;
            background: rgba(255, 255, 255, 0.12);
        }

    .services-section {
        background: #f7f7f5;
        padding: 40px 16px 80px;
        min-height: 75vh;
    }

    .filter-pills {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 10px;
        margin-bottom: 34px;
    }

    .filter-btn {
        padding: 8px 18px;
        border-radius: 999px;
        border: 1px solid #dcdcdc;
        background: #ffffff;
        color: #333333;
        font-size: 13.5px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .filter-btn:hover,
        .filter-btn.active {
            background: #171717;
            color: #ffffff;
            border-color: #171717;
        }

    .service-card {
        background: #ffffff;
        border: 1px solid #eaeaea;
        border-radius: 20px;
        overflow: hidden;
        height: 100%;
        display: flex;
        flex-direction: column;
        transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
    }

        .service-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 18px 40px rgba(0, 0, 0, 0.09);
            border-color: #d6c278;
        }

        .service-card.featured-card {
            border: 1.5px solid #c9a227;
        }

    .service-img-wrap {
        position: relative;
        height: 215px;
        overflow: hidden;
        background: #1f1f1f;
    }

        .service-img-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.45s ease;
        }

    .service-card:hover .service-img-wrap img {
        transform: scale(1.06);
    }

    .service-rating-pill {
        position: absolute;
        bottom: 12px;
        right: 12px;
        background: rgba(23, 23, 23, 0.85);
        backdrop-filter: blur(6px);
        color: #ffffff;
        font-size: 12px;
        font-weight: 600;
        padding: 4px 10px;
        border-radius: 999px;
    }

    .service-body {
        padding: 22px 24px 24px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .service-meta-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 10px;
    }

    .badge-tag {
        font-size: 10.5px;
        font-weight: 800;
        letter-spacing: 0.7px;
        text-transform: uppercase;
        padding: 4px 10px;
        border-radius: 6px;
        background: #f2f2f0;
        color: #333333;
    }

    .badge-gold {
        background: #f5c518;
        color: #171717;
    }

    .service-price {
        font-size: 20px;
        font-weight: 800;
        color: #146c43;
    }

    .service-name {
        font-size: 18.5px;
        font-weight: 800;
        color: #171717;
        margin-bottom: 8px;
    }

    .service-desc {
        font-size: 13.5px;
        color: #666666;
        line-height: 1.55;
        margin-bottom: 18px;
        flex-grow: 1;
    }

    .service-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 14px;
        border-top: 1px solid #f0f0f0;
    }

    .service-duration {
        font-size: 13px;
        font-weight: 600;
        color: #555555;
    }

    .btn-book-service {
        background: #171717;
        color: #ffffff;
        font-size: 13px;
        font-weight: 600;
        padding: 9px 18px;
        border-radius: 999px;
        text-decoration: none;
        transition: background-color 0.2s ease, color 0.2s ease;
    }

        .btn-book-service:hover {
            background: #c9a227;
            color: #111111;
        }
</style>

<!-- HERO HEADER -->
<section class="services-hero">
    <div class="container">
        <span class="hero-eyebrow">GenZCut Salon Studio</span>
        <h1>Precision Cuts & Grooming</h1>
        <p>Handcrafted styles, hot towel beard rituals, and rejuvenating scalp therapies delivered by master stylists.</p>

        <div class="search-filter-bar">
            <input type="text"
                   id="serviceSearch"
                   class="service-search-input"
                   placeholder="Search haircut, beard, spa, combo..." />
        </div>
    </div>
</section>

<!-- SERVICES GRID -->
<section class="services-section">
    <div class="container">
        <!-- CATEGORY TABS -->
        <div class="filter-pills">
            <button type="button" class="filter-btn active" data-filter="all">All Services</button>
            <button type="button" class="filter-btn" data-filter="haircut">Haircuts</button>
            <button type="button" class="filter-btn" data-filter="beard">Beard & Shave</button>
            <button type="button" class="filter-btn" data-filter="spa">Hair Spa</button>
            <button type="button" class="filter-btn" data-filter="combo">Combos</button>
        </div>

        <div class="row g-4" id="servicesGrid">
            <!-- 1. Signature Skin Fade -->
            <div class="col-md-6 col-lg-4 service-item" data-category="haircut" data-title="signature skin fade haircut">
                <div class="service-card">
                    <div class="service-img-wrap">
                        <img src="https://images.unsplash.com/photo-1621605815971-fbc98d665033?auto=format&fit=crop&w=800&q=80" alt="Signature Skin Fade" />
                        <span class="service-rating-pill">★ 4.9 (120+)</span>
                    </div>
                    <div class="service-body">
                        <div class="service-meta-top">
                            <span class="badge-tag badge-gold">Most Popular</span>
                            <span class="service-price">₹350</span>
                        </div>
                        <h3 class="service-name">Signature Skin Fade</h3>
                        <p class="service-desc">Precision zero-gap fade on the sides paired with custom textured styling on top for a sharp finish.</p>
                        <div class="service-footer">
                            <span class="service-duration">⏱ 30 Mins</span>
                            <a asp-controller="Customer" asp-action="BookAppointment" class="btn-book-service">Book Now →</a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2. Textured French Crop -->
            <div class="col-md-6 col-lg-4 service-item" data-category="haircut" data-title="textured french crop haircut">
                <div class="service-card">
                    <div class="service-img-wrap">
                        <img src="https://images.unsplash.com/photo-1599351431202-1e0f0137899a?auto=format&fit=crop&w=800&q=80" alt="Textured French Crop" />
                        <span class="service-rating-pill">★ 4.8 (95+)</span>
                    </div>
                    <div class="service-body">
                        <div class="service-meta-top">
                            <span class="badge-tag">Trending</span>
                            <span class="service-price">₹300</span>
                        </div>
                        <h3 class="service-name">Textured French Crop</h3>
                        <p class="service-desc">Low-maintenance yet high-impact choppy layers designed for effortless daily casual styling.</p>
                        <div class="service-footer">
                            <span class="service-duration">⏱ 25 Mins</span>
                            <a asp-controller="Customer" asp-action="BookAppointment" class="btn-book-service">Book Now →</a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 3. Executive Beard Styling -->
            <div class="col-md-6 col-lg-4 service-item" data-category="beard" data-title="executive beard styling shave">
                <div class="service-card">
                    <div class="service-img-wrap">
                        <img src="https://images.unsplash.com/photo-1503951914875-452162b0f3f1?auto=format&fit=crop&w=800&q=80" alt="Executive Beard Styling" />
                        <span class="service-rating-pill">★ 4.9 (140+)</span>
                    </div>
                    <div class="service-body">
                        <div class="service-meta-top">
                            <span class="badge-tag">Grooming</span>
                            <span class="service-price">₹200</span>
                        </div>
                        <h3 class="service-name">Executive Beard Styling</h3>
                        <p class="service-desc">Razor-sharp cheek line-ups, symmetrical beard sculpting, and a soothing eucalyptus hot towel finish.</p>
                        <div class="service-footer">
                            <span class="service-duration">⏱ 20 Mins</span>
                            <a asp-controller="Customer" asp-action="BookAppointment" class="btn-book-service">Book Now →</a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 4. Deep Conditioning Hair Spa -->
            <div class="col-md-6 col-lg-4 service-item" data-category="spa" data-title="deep conditioning hair spa relaxation">
                <div class="service-card">
                    <div class="service-img-wrap">
                        <img src="https://images.unsplash.com/photo-1560066984-138dadb4c035?auto=format&fit=crop&w=800&q=80" alt="Deep Conditioning Hair Spa" />
                        <span class="service-rating-pill">★ 4.8 (80+)</span>
                    </div>
                    <div class="service-body">
                        <div class="service-meta-top">
                            <span class="badge-tag">Relaxation</span>
                            <span class="service-price">₹500</span>
                        </div>
                        <h3 class="service-name">Deep Conditioning Hair Spa</h3>
                        <p class="service-desc">Revitalize your scalp and hair roots with essential argan nutrient oils, acupressure massage, and mist steam.</p>
                        <div class="service-footer">
                            <span class="service-duration">⏱ 45 Mins</span>
                            <a asp-controller="Customer" asp-action="BookAppointment" class="btn-book-service">Book Now →</a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 5. Classic Gentleman Cut -->
            <div class="col-md-6 col-lg-4 service-item" data-category="haircut" data-title="classic gentleman cut formal">
                <div class="service-card">
                    <div class="service-img-wrap">
                        <img src="https://images.unsplash.com/photo-1519085360753-af0119f7cbe7?auto=format&fit=crop&w=800&q=80" alt="Classic Gentleman Cut" />
                        <span class="service-rating-pill">★ 4.7 (110+)</span>
                    </div>
                    <div class="service-body">
                        <div class="service-meta-top">
                            <span class="badge-tag">Classic</span>
                            <span class="service-price">₹250</span>
                        </div>
                        <h3 class="service-name">Classic Gentleman Cut</h3>
                        <p class="service-desc">Traditional scissor-over-comb and tapered clipper cut tailored for a clean corporate or formal look.</p>
                        <div class="service-footer">
                            <span class="service-duration">⏱ 25 Mins</span>
                            <a asp-controller="Customer" asp-action="BookAppointment" class="btn-book-service">Book Now →</a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 6. GenZ Ultimate Grooming Combo -->
            <div class="col-md-6 col-lg-4 service-item" data-category="combo" data-title="genz ultimate grooming combo facial">
                <div class="service-card featured-card">
                    <div class="service-img-wrap">
                        <img src="https://images.unsplash.com/photo-1585747860715-2ba37e788b70?auto=format&fit=crop&w=800&q=80" alt="GenZ Ultimate Grooming Combo" />
                        <span class="service-rating-pill">★ 5.0 (210+)</span>
                    </div>
                    <div class="service-body">
                        <div class="service-meta-top">
                            <span class="badge-tag badge-gold">Combo Deal</span>
                            <span class="service-price">₹600</span>
                        </div>
                        <h3 class="service-name">GenZ Ultimate Grooming Combo</h3>
                        <p class="service-desc">Complete makeover package including Custom Haircut, Precision Beard Shaping, and Charcoal Facial Clean-up.</p>
                        <div class="service-footer">
                            <span class="service-duration">⏱ 60 Mins</span>
                            <a asp-controller="Customer" asp-action="BookAppointment" class="btn-book-service">Book Now →</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            const filterBtns = document.querySelectorAll(".filter-btn");
            const searchInput = document.getElementById("serviceSearch");
            const cards = document.querySelectorAll(".service-item");
            let activeCategory = "all";

            function applyFilters() {
                const query = (searchInput?.value || "").trim().toLowerCase();
                cards.forEach(card => {
                    const cat = card.getAttribute("data-category") || "";
                    const title = card.getAttribute("data-title") || "";
                    const matchesCategory = activeCategory === "all" || cat === activeCategory;
                    const matchesSearch = !query || title.includes(query);
                    card.style.display = (matchesCategory && matchesSearch) ? "" : "none";
                });
            }

            filterBtns.forEach(btn => {
                btn.addEventListener("click", function () {
                    filterBtns.forEach(b => b.classList.remove("active"));
                    this.classList.add("active");
                    activeCategory = this.getAttribute("data-filter") || "all";
                    applyFilters();
                });
            });

            searchInput?.addEventListener("input", applyFilters);
        })();
    </script>
}