@model GenZCut.Models.Appointment
@using GenZCut.Models

@{
    ViewData["Title"] = "Book an Appointment";
    var hairstyles = ViewBag.Hairstyles as List<Hairstyle> ?? new List<Hairstyle>();
    var barbers = ViewBag.Barbers as List<Barber> ?? new List<Barber>();
    var todayStr = DateTime.Today.ToString("yyyy-MM-dd");
}

<style>
    .booking-page {
        min-height: 85vh;
        background: #f7f7f5;
        padding: 45px 16px 75px;
    }

    .booking-card {
        max-width: 720px;
        margin: 0 auto;
        background: #ffffff;
        border: 1px solid #eaeaea;
        border-radius: 22px;
        padding: 40px 38px;
        box-shadow: 0 12px 35px rgba(0, 0, 0, 0.05);
    }

    .booking-title {
        font-size: 30px;
        font-weight: 800;
        color: #171717;
        margin-bottom: 6px;
        letter-spacing: -0.4px;
    }

    .booking-subtitle {
        color: #777777;
        font-size: 14px;
        margin-bottom: 28px;
    }

    .booking-card .form-label {
        font-size: 13.5px;
        font-weight: 600;
        color: #222222;
        margin-bottom: 6px;
    }

    .booking-card .form-control,
    .booking-card .form-select {
        padding: 12px 14px;
        border-radius: 10px;
        border: 1px solid #dcdcdc;
        font-size: 14px;
        color: #171717;
    }

        .booking-card .form-control:focus,
        .booking-card .form-select:focus {
            border-color: #171717;
            box-shadow: 0 0 0 0.15rem rgba(23, 23, 23, 0.12);
        }

    .btn-confirm-booking {
        width: 100%;
        background: #171717;
        color: #ffffff;
        border: none;
        border-radius: 10px;
        padding: 14px 20px;
        font-size: 15px;
        font-weight: 600;
        transition: background-color 0.2s ease, color 0.2s ease;
    }

        .btn-confirm-booking:hover {
            background: #c9a227;
            color: #111111;
        }

    .back-dashboard-link {
        display: inline-block;
        margin-top: 18px;
        font-size: 13.5px;
        font-weight: 600;
        color: #555555;
        text-decoration: none;
    }

        .back-dashboard-link:hover {
            color: #171717;
            text-decoration: underline;
        }
</style>

<div class="booking-page">
    <div class="booking-card">
        <h1 class="booking-title">Book an Appointment</h1>
        <p class="booking-subtitle">Choose your preferred service, barber, date and time.</p>

        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small rounded-3"></div>

        <form asp-controller="Customer" asp-action="BookAppointment" method="post" id="appointmentForm">
            @Html.AntiForgeryToken()

            <!-- SELECT SERVICE -->
            <div class="mb-3">
                <label asp-for="StyleId" class="form-label">Select Service</label>
                <select asp-for="StyleId" class="form-select">
                    <option value="">-- Select a Service --</option>
                    @foreach (var style in hairstyles)
                    {
                        <option value="@style.StyleId">
                            @style.StyleName (@style.Duration mins - ₹@style.Price.ToString("0.##"))
                        </option>
                    }
                </select>
                <span asp-validation-for="StyleId" class="text-danger small"></span>
            </div>

            <!-- SELECT REGISTERED & AVAILABLE BARBER -->
            <div class="mb-3">
                <label asp-for="BarberId" class="form-label">Select Barber</label>
                <select asp-for="BarberId" class="form-select">
                    <option value="">-- Select a Barber --</option>
                    @foreach (var barber in barbers)
                    {
                        var barberDisplayName = string.IsNullOrWhiteSpace(barber.FullName)
                        ? $"Barber #{barber.BarberId}"
                        : barber.FullName.Trim();

                        var details = !string.IsNullOrWhiteSpace(barber.Specialization)
                        ? $" ({barber.Specialization.Trim()})"
                        : barber.Experience > 0
                        ? $" ({barber.Experience} yrs exp)"
                        : "";

                        <option value="@barber.BarberId">@barberDisplayName@details</option>
                    }
                </select>
                @if (!barbers.Any())
                {
                    <div class="form-text text-danger">Abhi koi available barber nahi hai.</div>
                }
                <span asp-validation-for="BarberId" class="text-danger small"></span>
            </div>

            <!-- DATE & TIME -->
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="AppointmentDate" class="form-label">Appointment Date</label>
                    <input asp-for="AppointmentDate"
                           type="date"
                           id="appointmentDate"
                           min="@todayStr"
                           class="form-control" />
                    <span asp-validation-for="AppointmentDate" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="AppointmentTime" class="form-label">Appointment Time</label>
                    <input asp-for="AppointmentTime"
                           type="time"
                           id="appointmentTime"
                           class="form-control" />
                    <span asp-validation-for="AppointmentTime" class="text-danger small" id="timeValidationMsg"></span>
                </div>
            </div>

            <button type="submit" class="btn-confirm-booking">
                Confirm Appointment
            </button>
        </form>

        <a asp-controller="Customer" asp-action="Dashboard" class="back-dashboard-link">
            ← Back to Dashboard
        </a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const dateInput = document.getElementById("appointmentDate");
            const timeInput = document.getElementById("appointmentTime");
            const form = document.getElementById("appointmentForm");
            const timeMsg = document.getElementById("timeValidationMsg");

            function getCurrentTimeHHMM() {
                const now = new Date();
                const hh = String(now.getHours()).padStart(2, "0");
                const mm = String(now.getMinutes()).padStart(2, "0");
                return `${hh}:${mm}`;
            }

            function getTodayYYYYMMDD() {
                const now = new Date();
                const yyyy = now.getFullYear();
                const mm = String(now.getMonth() + 1).padStart(2, "0");
                const dd = String(now.getDate()).padStart(2, "0");
                return `${yyyy}-${mm}-${dd}`;
            }

            function syncTimeMin() {
                if (!dateInput || !timeInput) return;
                if (dateInput.value === getTodayYYYYMMDD()) {
                    timeInput.min = getCurrentTimeHHMM();
                } else {
                    timeInput.removeAttribute("min");
                }
            }

            dateInput?.addEventListener("change", syncTimeMin);
            syncTimeMin();

            form?.addEventListener("submit", function (e) {
                if (!dateInput || !timeInput) return;
                if (timeMsg) {
                    timeMsg.textContent = "";
                }
                if (dateInput.value === getTodayYYYYMMDD() && timeInput.value && timeInput.value < getCurrentTimeHHMM()) {
                    e.preventDefault();
                    if (timeMsg) {
                        timeMsg.textContent = "Jo time khatam ho gaya hai usme appointment nahi le sakte.";
                    }
                }
            });
        })();
    </script>
}