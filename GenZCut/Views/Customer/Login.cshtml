@{
    ViewData["Title"] = "Customer Login";
}

<style>
    .customer-login-page {
        min-height: 85vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f7f7f5;
        padding: 40px 20px;
    }

    .login-card {
        width: 100%;
        max-width: 430px;
        background: white;
        padding: 40px;
        border-radius: 18px;
        border: 1px solid #e5e5e5;
        box-shadow: 0 12px 35px rgba(0,0,0,0.08);
    }

    .login-logo {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: #111;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
        font-size: 22px;
        font-weight: 700;
    }

    .login-heading {
        text-align: center;
        margin-bottom: 28px;
    }

    .login-heading h2 {
        font-weight: 700;
        margin-bottom: 8px;
    }

    .login-heading p {
        color: #777;
        margin: 0;
        font-size: 14px;
    }

    .form-label {
        font-weight: 600;
        font-size: 14px;
    }

    .form-control {
        height: 48px;
        border-radius: 9px;
        border: 1px solid #dcdcdc;
    }

    .form-control:focus {
        border-color: #111;
        box-shadow: 0 0 0 3px rgba(0,0,0,0.08);
    }

    .login-btn {
        width: 100%;
        height: 48px;
        border: none;
        border-radius: 9px;
        background: #111;
        color: white;
        font-weight: 600;
        margin-top: 8px;
    }

    .login-btn:hover {
        background: #c9a227;
        color: #111;
    }

    .register-text {
        text-align: center;
        margin-top: 22px;
        font-size: 14px;
        color: #666;
    }

    .register-text a {
        color: #a17c08;
        font-weight: 600;
        text-decoration: none;
    }

    .register-text a:hover {
        text-decoration: underline;
    }
</style>


<div class="customer-login-page">

    <div class="login-card">

        <div class="login-logo">
            GZ
        </div>

        <div class="login-heading">
            <h2>Welcome Back</h2>
            <p>Login to your GenZCut customer account</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                <div asp-validation-summary="ModelOnly"></div>
            </div>
        }

        <form asp-controller="Customer"
              asp-action="Login"
              method="post">

            @Html.AntiForgeryToken()

            <div class="mb-3">

                <label for="email"
                       class="form-label">
                    Email Address
                </label>

                <input type="email"
                       id="email"
                       name="email"
                       class="form-control"
                       placeholder="Enter your email"
                       autocomplete="email"
                       required />

            </div>


            <div class="mb-3">

                <label for="password"
                       class="form-label">
                    Password
                </label>

                <input type="password"
                       id="password"
                       name="password"
                       class="form-control"
                       placeholder="Enter your password"
                       autocomplete="current-password"
                       required />

            </div>


            <button type="submit"
                    class="login-btn">
                Login
            </button>

        </form>


        <div class="register-text">

            Don't have an account?

            <a asp-controller="Customer"
               asp-action="Register">
                Create Account
            </a>

        </div>

    </div>

</div>