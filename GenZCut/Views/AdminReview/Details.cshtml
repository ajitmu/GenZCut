@model GenZCut.Models.Admin.AdminReviewViewModel

@{
    ViewData["Title"] = "Review Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Review Details</h2>

        <a asp-controller="AdminReview"
           asp-action="Index"
           class="btn btn-secondary">
            Back to Reviews
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white">
            Review #@Model.Id
        </div>

        <div class="card-body">

            <div class="row mb-3">
                <div class="col-md-6">
                    <strong>Customer ID:</strong>
                    <p>@(Model.CustomerId ?? "Not Available")</p>
                </div>

                <div class="col-md-6">
                    <strong>Customer Name:</strong>
                    <p>@(Model.CustomerName ?? "Not Available")</p>
                </div>
            </div>

            <hr />

            <div class="row mb-3">
                <div class="col-md-6">
                    <strong>Barber Name:</strong>
                    <p>@(Model.BarberName ?? "Not Available")</p>
                </div>

                <div class="col-md-6">
                    <strong>Service Name:</strong>
                    <p>@(Model.ServiceName ?? "Not Available")</p>
                </div>
            </div>

            <hr />

            <div class="mb-3">
                <strong>Rating:</strong>
                <p class="text-warning fs-4">
                    @for (int i = 1; i <= 5; i++)
                    {
                        if (i <= Model.Rating)
                        {
                            <span>★</span>
                        }
                        else
                        {
                            <span class="text-secondary">☆</span>
                        }
                    }
                    <span class="text-dark fs-6">
                        (@Model.Rating / 5)
                    </span>
                </p>
            </div>

            <div class="mb-3">
                <strong>Review Comment:</strong>
                <div class="border rounded p-3 bg-light">
                    @(string.IsNullOrWhiteSpace(Model.Comment)
                                        ? "No comment provided."
                                        : Model.Comment)
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <strong>Review Date:</strong>
                    <p>@Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</p>
                </div>

                <div class="col-md-6">
                    <strong>Visibility Status:</strong>
                    <p>
                        @if (Model.IsVisible)
                        {
                            <span class="badge bg-success">Visible</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Hidden</span>
                        }
                    </p>
                </div>
            </div>

            <a asp-controller="AdminReview"
               asp-action="Index"
               class="btn btn-secondary">
                Back
            </a>

        </div>
    </div>
</div>