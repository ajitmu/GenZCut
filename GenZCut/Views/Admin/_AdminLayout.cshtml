<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GenZCut Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body {
            background: radial-gradient(circle at top right, #1e1b4b 0%, #0b0f19 50%, #070a12 100%);
            color: #f8fafc;
            min-height: 100vh;
        }

        .admin-sidebar {
            min-height: 100vh;
            background: #111827;
            border-right: 1px solid rgba(255, 255, 255, 0.08);
        }

            .admin-sidebar .nav-link {
                color: #94a3b8;
                border-radius: 10px;
                margin-bottom: 6px;
                padding: 10px 14px;
                font-weight: 600;
            }

                .admin-sidebar .nav-link.active, .admin-sidebar .nav-link:hover {
                    background: linear-gradient(135deg, #6366f1, #ec4899);
                    color: #fff;
                }

        .glass-card {
            background: rgba(19, 26, 43, 0.88);
            border: 1px solid rgba(255, 255, 255, 0.09);
            border-radius: 16px;
        }

        .kpi-card {
            border-radius: 16px;
            padding: 18px;
            color: #fff;
        }

        .kpi-gold {
            background: linear-gradient(135deg, #f59e0b, #d97706);
        }

        .kpi-purple {
            background: linear-gradient(135deg, #7c3aed, #4f46e5);
        }

        .kpi-cyan {
            background: linear-gradient(135deg, #06b6d4, #0284c7);
        }

        .kpi-pink {
            background: linear-gradient(135deg, #ec4899, #be185d);
        }

        .kpi-emerald {
            background: linear-gradient(135deg, #10b981, #059669);
        }

        .btn-gradient {
            background: linear-gradient(135deg, #f59e0b, #ec4899);
            border: none;
            color: #fff;
            font-weight: 600;
        }

            .btn-gradient:hover {
                color: #fff;
                opacity: 0.92;
            }
    </style>
</head>
<body>
    @{
        string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    }

    <div class="container-fluid">
        <div class="row">
            <aside class="col-md-3 col-lg-2 admin-sidebar p-3 d-flex flex-column justify-content-between">
                <div>
                    <div class="fs-4 fw-bold mb-4 px-2 text-warning">✂️ GenZCut Admin</div>
                    <nav class="nav flex-column">
                        <a class="nav-link @(currentAction == "Dashboard" ? "active" : "")"
                           asp-controller="Admin" asp-action="Dashboard">
                            <i class="bi bi-grid-1x2-fill me-2"></i>Dashboard
                        </a>
                        <a class="nav-link @(currentAction == "Appointments" ? "active" : "")"
                           asp-controller="Admin" asp-action="Appointments">
                            <i class="bi bi-calendar2-check-fill me-2"></i>Appointments
                        </a>
                        <a class="nav-link @(currentAction == "Barbers" ? "active" : "")"
                           asp-controller="Admin" asp-action="Barbers">
                            <i class="bi bi-scissors me-2"></i>Barbers
                        </a>
                    </nav>
                </div>
                <div>
                    <a asp-controller="Admin" asp-action="Logout" class="btn btn-outline-danger btn-sm w-100">
                        <i class="bi bi-box-arrow-right me-1"></i>Logout
                    </a>
                </div>
            </aside>

            <main class="col-md-9 col-lg-10 p-4">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>