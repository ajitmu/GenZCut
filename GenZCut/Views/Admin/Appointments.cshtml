@model List<GenZCut.Models.AdminAppointmentRowViewModel>
@using System.Globalization

@{
    ViewData["Title"] = "Appointments";
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h2 class="fw-bold mb-0">All Appointments</h2>
        <small class="text-secondary">Manage booking status across customers and barbers</small>
    </div>
    <a asp-action="Dashboard" class="btn btn-outline-light btn-sm px-3">
        ← Back to Dashboard
    </a>
</div>

<div class="glass-card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Customer</th>
                    <th>Phone</th>
                    <th>Barber</th>
                    <th>Style</th>
                    <th>Price</th>
                    <th>Date</th>
                    <th>Time</th>
                    <th>Status</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Count > 0)
                {
                    foreach (var row in Model)
                    {
                        string status = string.IsNullOrWhiteSpace(row.Status) ? "Pending" : row.Status;
                        string statusBadgeClass = status.ToLowerInvariant() switch
                        {
                            "confirmed" => "bg-success text-white",
                            "completed" => "bg-primary text-white",
                            "rejected" or "cancelled" => "bg-danger text-white",
                            _ => "bg-warning text-dark"
                        };

                        string formattedTime = DateTime.Today.Add(row.AppointmentTime).ToString("hh:mm tt", CultureInfo.InvariantCulture);
                        string formattedDate = row.AppointmentDate == DateTime.MinValue
                        ? ""
                        : row.AppointmentDate.ToString("dd MMM yyyy", CultureInfo.InvariantCulture);

                        <tr>
                            <td>#@row.AppointmentId</td>
                            <td class="fw-semibold">@row.CustomerName</td>
                            <td>@row.CustomerPhone</td>
                            <td>@row.BarberName</td>
                            <td><span class="badge bg-info text-dark">@row.StyleName</span></td>
                            <td>₹@row.Price.ToString("0.##")</td>
                            <td>@formattedDate</td>
                            <td>@formattedTime</td>
                            <td><span class="badge @statusBadgeClass">@status</span></td>
                            <td class="text-end">
                                <form asp-action="UpdateStatus" method="post" class="d-inline-flex gap-1">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="appointmentId" value="@row.AppointmentId" />
                                    <button type="submit" name="status" value="Confirmed" class="btn btn-sm btn-success">
                                        Confirm
                                    </button>
                                    <button type="submit" name="status" value="Completed" class="btn btn-sm btn-primary">
                                        Complete
                                    </button>
                                    <button type="submit" name="status" value="Rejected" class="btn btn-sm btn-danger">
                                        Reject
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="10" class="text-center text-secondary py-4">No appointments found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>