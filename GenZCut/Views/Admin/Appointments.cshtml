@using System.Data
@model DataTable
@{
    ViewData["Title"] = "Appointments";
    Layout = "_AdminLayout";
}

<style>
    .lux-appt-wrap {
        background-color: #0b0f19;
        background-image: linear-gradient(135deg, #0b0f19, #1b1838);
        border: 1px solid rgba(251, 191, 36, 0.22);
        border-radius: 18px;
        padding: 24px;
        color: #f8fafc;
        box-shadow: 0 18px 40px rgba(0, 0, 0, 0.35);
    }

    .lux-appt-header {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 14px;
        padding-bottom: 18px;
        margin-bottom: 20px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .lux-appt-title {
        margin: 0;
        font-weight: 800;
        color: #fbbf24;
        letter-spacing: 0.3px;
    }

    .lux-table {
        color: #f1f5f9;
        margin-bottom: 0;
    }

        .lux-table thead th {
            background-color: #151c2c;
            color: #cbd5e1;
            font-size: 0.76rem;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            border-color: rgba(255, 255, 255, 0.08);
            padding: 13px 14px;
        }

        .lux-table tbody td {
            border-color: rgba(255, 255, 255, 0.07);
            padding: 13px 14px;
            vertical-align: middle;
        }

        .lux-table tbody tr:hover {
            background-color: rgba(251, 191, 36, 0.05);
        }

    .btn-lux-save {
        background-color: #eab308;
        color: #0f172a;
        border: none;
        font-weight: 700;
    }

        .btn-lux-save:hover {
            background-color: #facc15;
            color: #0f172a;
        }
</style>

<div class="lux-appt-wrap">
    <div class="lux-appt-header">
        <div>
            <h2 class="lux-appt-title"><i class="bi bi-calendar2-check-fill me-2"></i>Appointments Control</h2>
            <small style="color: #94a3b8;">Total Bookings: @(Model?.Rows.Count ?? 0)</small>
        </div>
        <a href="/Admin/Dashboard" class="btn btn-outline-warning btn-sm fw-semibold px-3">← Dashboard</a>
    </div>

    <div class="table-responsive rounded-3 overflow-hidden border border-secondary border-opacity-25">
        <table class="table lux-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Customer</th>
                    <th>Phone</th>
                    <th>Barber</th>
                    <th>Style</th>
                    <th>Price</th>
                    <th>Date &amp; Time</th>
                    <th>Status</th>
                    <th>Update Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Rows.Count > 0)
                {
                    foreach (DataRow row in Model.Rows)
                    {
                        var apptId = row["AppointmentId"]?.ToString() ?? "0";
                        var customer = row["CustomerName"]?.ToString() ?? "-";
                        var phone = row["Phone"]?.ToString() ?? "-";
                        var barber = row["BarberName"]?.ToString() ?? "-";
                        var style = row["StyleName"]?.ToString() ?? "-";
                        var price = row["Price"]?.ToString() ?? "0";
                        var time = row["AppointmentTime"]?.ToString() ?? "-";
                        var status = row["Status"]?.ToString() ?? "Pending";

                        var dateStr = "-";
                        if (row["AppointmentDate"] != DBNull.Value && DateTime.TryParse(row["AppointmentDate"].ToString(), out var d))
                        {
                            dateStr = d.ToString("dd MMM yyyy");
                        }

                        var statusBadge = status switch
                        {
                            "Completed" => "bg-success",
                            "Confirmed" => "bg-info text-dark",
                            "Cancelled" => "bg-danger",
                            _ => "bg-warning text-dark"
                        };

                        <tr>
                            <td style="color: #94a3b8;">#@apptId</td>
                            <td class="fw-semibold">@customer</td>
                            <td style="color: #cbd5e1;">@phone</td>
                            <td>@barber</td>
                            <td><span class="badge bg-primary">@style</span></td>
                            <td class="fw-bold" style="color: #fbbf24;">₹@price</td>
                            <td class="small">@dateStr - @time</td>
                            <td><span class="badge rounded-pill @statusBadge px-3">@status</span></td>
                            <td>
                                <form action="/Admin/UpdateStatus" method="post" class="d-flex gap-2">
                                    <input type="hidden" name="appointmentId" value="@apptId" />
                                    <select name="status" class="form-select form-select-sm bg-dark text-light border-secondary" style="width: 130px;">
                                        <option value="Pending" selected="@(status == "Pending")">Pending</option>
                                        <option value="Confirmed" selected="@(status == "Confirmed")">Confirmed</option>
                                        <option value="Completed" selected="@(status == "Completed")">Completed</option>
                                        <option value="Cancelled" selected="@(status == "Cancelled")">Cancelled</option>
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-lux-save px-3">Save</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center py-4" style="color: #94a3b8;">No appointments found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>