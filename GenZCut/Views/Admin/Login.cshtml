@model GenZCut.Models.AdminLoginViewModel
@{
    ViewData["Title"] = "Admin Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Login - GenZCut Studio</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            min-height: 100vh;
            background: radial-gradient(circle at 20% 20%, #311042 0%, #0f172a 45%, #060913 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #f8fafc;
        }

        .login-glass {
            background: rgba(17, 24, 39, 0.78);
            border: 1px solid rgba(255, 255, 255, 0.12);
            backdrop-filter: blur(20px);
            border-radius: 24px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7), 0 0 40px rgba(236, 72, 153, 0.15);
        }

        .brand-gradient {
            background: linear-gradient(135deg, #f59e0b, #ec4899, #8b5cf6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .input-dark {
            background: rgba(15, 23, 42, 0.9);
            border: 1px solid rgba(255, 255, 255, 0.15);
            color: #fff;
            border-radius: 12px;
            padding: 12px 15px;
        }

            .input-dark:focus {
                background: rgba(15, 23, 42, 1);
                color: #fff;
                border-color: #ec4899;
                box-shadow: 0 0 0 0.25rem rgba(236, 72, 153, 0.25);
            }

        .btn-glow {
            background: linear-gradient(135deg, #f59e0b 0%, #ec4899 50%, #8b5cf6 100%);
            border: none;
            color: #fff;
            font-weight: 700;
            border-radius: 12px;
            padding: 13px;
            box-shadow: 0 10px 25px -5px rgba(236, 72, 153, 0.5);
            transition: transform 0.2s ease;
        }

            .btn-glow:hover {
                color: #fff;
                transform: translateY(-2px);
            }
    </style>
</head>
<body>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5 col-lg-4">
                <div class="login-glass p-4 p-md-5">
                    <div class="text-center mb-4">
                        <div class="fs-1 mb-1">✂️</div>
                        <h2 class="fw-extrabold brand-gradient mb-1">GenZCut Admin</h2>
                        <p class="text-secondary small">Executive Salon Management Portal</p>
                    </div>

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger py-2 small">@TempData["Error"]</div>
                    }
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success py-2 small">@TempData["Success"]</div>
                    }

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <form asp-action="Login" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label small text-light fw-semibold">Admin Email</label>
                            <input asp-for="Email" class="form-control input-dark" placeholder="admin@genzcut.com" />
                            <span asp-validation-for="Email" class="text-warning small"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="Password" class="form-label small text-light fw-semibold">Password</label>
                            <input asp-for="Password" class="form-control input-dark" placeholder="••••••••" />
                            <span asp-validation-for="Password" class="text-warning small"></span>
                        </div>
                        <button type="submit" class="btn btn-glow w-100">
                            <i class="bi bi-shield-lock-fill me-1"></i> Enter Control Center
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</body>
</html>