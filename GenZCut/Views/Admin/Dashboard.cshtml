@using System.Data
@model DataTable
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h2 class="fw-bold mb-0">Studio Overview <span class="badge bg-warning text-dark fs-6 ms-1">LIVE</span></h2>
        <small class="text-secondary">Logged in: <span class="text-info">@ViewBag.AdminEmail</span></small>
    </div>
    <a asp-action="Appointments" class="btn btn-gradient px-3">
        <i class="bi bi-calendar-check me-1"></i>All Appointments
    </a>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl">
        <div class="kpi-card kpi-gold">
            <div class="small text-uppercase opacity-75">Customers</div>
            <h2 class="fw-bold mb-0 mt-1">@(ViewBag.TotalCustomers ?? 0)</h2>
        </div>
    </div>
    <div class="col-sm-6 col-xl">
        <div class="kpi-card kpi-purple">
            <div class="small text-uppercase opacity-75">Barbers</div>
            <h2 class="fw-bold mb-0 mt-1">@(ViewBag.TotalBarbers ?? 0)</h2>
        </div>
    </div>
    <div class="col-sm-6 col-xl">
        <div class="kpi-card kpi-cyan">
            <div class="small text-uppercase opacity-75">Hairstyles</div>
            <h2 class="fw-bold mb-0 mt-1">@(ViewBag.TotalHairstyles ?? 0)</h2>
        </div>
    </div>
    <div class="col-sm-6 col-xl">
        <div class="kpi-card kpi-pink">
            <div class="small text-uppercase opacity-75">Appointments</div>
            <h2 class="fw-bold mb-0 mt-1">@(ViewBag.TotalAppointments ?? 0)</h2>
        </div>
    </div>
    <div class="col-sm-6 col-xl">
        <div class="kpi-card kpi-gold">
            <div class="small text-uppercase opacity-75">Pending</div>
            <h2 class="fw-bold mb-0 mt-1">@(ViewBag.PendingAppointments ?? 0)</h2>
        </div>
    </div>
</div>

<div class="glass-card overflow-hidden">
    <div class="p-3 px-4 border-bottom border-secondary border-opacity-25 fw-bold">
        Recent Appointments
    </div>
    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Customer</th>
                    <th>Barber</th>
                    <th>Style</th>
                    <th>Date</th>
                    <th>Time</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Rows.Count > 0)
                {
                    foreach (DataRow row in Model.Rows)
                    {
                        <tr>
                            <td>#@row["AppointmentId"]</td>
                            <td class="fw-semibold">@row["CustomerName"]</td>
                            <td>@row["BarberName"]</td>
                            <td><span class="badge bg-info text-dark">@row["StyleName"]</span></td>
                            <td>@Convert.ToDateTime(row["AppointmentDate"]).ToString("dd MMM yyyy")</td>
                            <td>@row["AppointmentTime"]</td>
                            <td><span class="badge bg-warning text-dark">@row["Status"]</span></td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-secondary py-4">No appointments found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>