@using System.Data
@model DataTable

@{
    ViewData["Title"] = "Barber Dashboard";
}

<div class="container mt-4">
    <!-- Success Alert Notification -->
    @if (TempData["SuccessMsg"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <strong>✅ Success!</strong> @TempData["SuccessMsg"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>💈 Barber Dashboard</h2>
        <a asp-action="Logout" class="btn btn-outline-danger btn-sm fw-bold">Logout</a>
    </div>

    <!-- Summary Statistics Cards -->
    <div class="row mb-4 text-white text-center">
        <div class="col-md-3 mb-2">
            <div class="card bg-primary shadow-sm p-3 rounded-3">
                <h5>Total Bookings</h5>
                <h3 class="fw-bold mb-0">@ViewBag.Total</h3>
            </div>
        </div>
        <div class="col-md-3 mb-2">
            <div class="card bg-warning text-dark shadow-sm p-3 rounded-3">
                <h5>Pending</h5>
                <h3 class="fw-bold mb-0">@ViewBag.Pending</h3>
            </div>
        </div>
        <div class="col-md-3 mb-2">
            <div class="card bg-success shadow-sm p-3 rounded-3">
                <h5>Confirmed</h5>
                <h3 class="fw-bold mb-0">@ViewBag.Confirmed</h3>
            </div>
        </div>
        <div class="col-md-3 mb-2">
            <div class="card bg-danger shadow-sm p-3 rounded-3">
                <h5>Rejected / Cancelled</h5>
                <h3 class="fw-bold mb-0">@ViewBag.Rejected</h3>
            </div>
        </div>
    </div>

    @if (Model.Rows.Count == 0)
    {
        <div class="alert alert-info shadow-sm rounded-3">Abhi koi appointments book nahi hui hain.</div>
    }
    else
    {
        <!-- Search and Quick Filter Controls -->
        <div class="row mb-3 align-items-center">
            <div class="col-md-4 mb-2">
                <input type="text" id="searchInput" onkeyup="filterTable()" class="form-control" placeholder="🔍 Search customer name or phone...">
            </div>
            <div class="col-md-8 text-md-end mb-2">
                <button class="btn btn-outline-secondary btn-sm me-1 active" onclick="filterByStatus('All')">All</button>
                <button class="btn btn-outline-warning btn-sm me-1" onclick="filterByStatus('Pending')">Pending</button>
                <button class="btn btn-outline-success btn-sm me-1" onclick="filterByStatus('Confirmed')">Confirmed</button>
                <button class="btn btn-outline-danger btn-sm" onclick="filterByStatus('Rejected')">Rejected</button>
            </div>
        </div>

        <!-- Appointments Table -->
        <div class="table-responsive shadow-sm rounded-3">
            <table class="table table-hover table-bordered align-middle mb-0" id="appointmentsTable">
                <thead class="table-dark">
                    <tr>
                        <th>Customer Name</th>
                        <th>Phone</th>
                        <th>Date</th>
                        <th>Time Slot</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (DataRow row in Model.Rows)
                    {
                        string status = row["Status"].ToString() ?? "Pending";
                        string badgeClass = status == "Confirmed" ? "bg-success" : (status == "Rejected" || status == "Cancelled" ? "bg-danger" : "bg-warning text-dark");

                        <tr data-status="@status">
                            <td><strong>@row["CustomerName"]</strong></td>
                            <td>@row["Phone"]</td>
                            <td>@Convert.ToDateTime(row["AppointmentDate"]).ToString("dd MMM yyyy")</td>
                            <td>@row["AppointmentTime"]</td>
                            <td>
                                <span class="badge @badgeClass fs-6 px-3 py-2">@status</span>
                            </td>
                            <td>
                                @if (status == "Pending")
                                {
                                    <div class="d-flex gap-2">
                                        <form asp-action="UpdateStatus" method="post">
                                            <input type="hidden" name="appointmentId" value="@row["AppointmentId"]" />
                                            <input type="hidden" name="status" value="Confirmed" />
                                            <button type="submit" class="btn btn-sm btn-success px-3">Accept</button>
                                        </form>

                                        <form asp-action="UpdateStatus" method="post">
                                            <input type="hidden" name="appointmentId" value="@row["AppointmentId"]" />
                                            <input type="hidden" name="status" value="Rejected" />
                                            <button type="submit" class="btn btn-sm btn-danger px-3">Reject</button>
                                        </form>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted fw-bold">No Actions</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script>
        function filterTable() {
            let input = document.getElementById("searchInput").value.toLowerCase();
            let rows = document.querySelectorAll("#appointmentsTable tbody tr");

            rows.forEach(row => {
                let text = row.innerText.toLowerCase();
                row.style.display = text.includes(input) ? "" : "none";
            });
        }

        function filterByStatus(statusName) {
            let rows = document.querySelectorAll("#appointmentsTable tbody tr");

            rows.forEach(row => {
                let rowStatus = row.getAttribute("data-status");
                if (statusName === "All" || rowStatus === statusName) {
                    row.style.display = "";
                } else {
                    row.style.display = "none";
                }
            });
        }
    </script>
}