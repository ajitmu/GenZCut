@model GenZCut.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<style>
    .auth-wrapper {
        min-height: 85vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #0f2027;
        background: linear-gradient(135deg, #16222a 0%, #203a43 50%, #2c5364 100%);
        padding: 40px 15px;
    }

    .auth-card {
        width: 100%;
        max-width: 420px;
        background: #ffffff;
        border-radius: 20px;
        padding: 36px 32px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
    }

    .auth-badge {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: #ff4b5c;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 14px;
        font-size: 20px;
        font-weight: 700;
    }

    .auth-title {
        font-weight: 800;
        color: #171717;
        margin-bottom: 4px;
    }

    .auth-subtitle {
        color: #6c757d;
        font-size: 13.5px;
        margin-bottom: 22px;
    }

    .btn-login-primary {
        background: linear-gradient(90deg, #ff5f6d 0%, #ff4b5c 100%);
        border: none;
        color: #fff;
        font-weight: 600;
        padding: 11px;
        border-radius: 10px;
        width: 100%;
        transition: 0.2s;
    }

        .btn-login-primary:hover {
            opacity: 0.95;
            color: #fff;
        }

    .back-home-link {
        display: inline-block;
        margin-top: 10px;
        font-size: 13px;
        color: #555;
        text-decoration: none;
        font-weight: 500;
    }

        .back-home-link:hover {
            color: #111;
            text-decoration: underline;
        }
</style>

<div class="auth-wrapper">
    <div class="auth-card text-center">
        <div class="auth-badge">✂</div>
        <h3 class="auth-title">GenZCut</h3>
        <p class="auth-subtitle">Welcome back! Please login to your account.</p>

        @if (TempData["SuccessMsg"] != null)
        {
            <div class="alert alert-success py-2 small text-start">
                @TempData["SuccessMsg"]
            </div>
        }

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger py-2 small text-start">
                ▲ @ViewBag.Error
            </div>
        }

        <form asp-controller="Account" asp-action="Login" method="post" class="text-start">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="Email" class="form-label small text-muted mb-1">Email Address</label>
                <input asp-for="Email" class="form-control" placeholder="Enter your email" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label small text-muted mb-1">Password</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="Password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn-login-primary mt-1">
                → Log In
            </button>
        </form>

        <div class="mt-3 small text-muted">
            Don't have an account?
            <a asp-controller="Account" asp-action="Register" class="text-danger fw-semibold text-decoration-none">Sign Up</a>
        </div>

        <div>
            <a asp-controller="Home" asp-action="Index" class="back-home-link">
                ← Back to Home
            </a>
        </div>

        <div class="mt-4 pt-2 border-top text-muted" style="font-size: 11.5px;">
            © 2026 GenZCut Salon Management. All rights reserved.
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}