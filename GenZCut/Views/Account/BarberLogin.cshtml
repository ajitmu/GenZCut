@model GenZCut.Models.LoginViewModel

@{
    ViewData["Title"] = "Barber Partner Login";
}

<style>
    .barber-login-page {
        min-height: calc(100vh - 120px);
        background: #f7f7f5;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 16px;
    }

    .barber-login-card {
        width: 100%;
        max-width: 440px;
        background: #ffffff;
        border: 1px solid #eaeaea;
        border-radius: 22px;
        padding: 40px 36px;
        box-shadow: 0 12px 35px rgba(0, 0, 0, 0.06);
    }

    .barber-brand-badge {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: #171717;
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 18px;
        font-size: 20px;
        font-weight: 800;
        letter-spacing: 0.5px;
    }

    .barber-login-title {
        font-size: 30px;
        font-weight: 800;
        color: #171717;
        margin-bottom: 6px;
        letter-spacing: -0.5px;
    }

    .barber-login-subtitle {
        color: #777777;
        font-size: 14px;
        margin-bottom: 26px;
    }

    .barber-login-card .form-label {
        font-size: 13.5px;
        font-weight: 600;
        color: #222222;
        margin-bottom: 6px;
    }

    .barber-login-card .form-control {
        padding: 12px 14px;
        border-radius: 10px;
        border: 1px solid #dcdcdc;
        font-size: 14px;
        color: #171717;
    }

        .barber-login-card .form-control::placeholder {
            color: #9b9b9b;
        }

        .barber-login-card .form-control:focus {
            border-color: #171717;
            box-shadow: 0 0 0 0.15rem rgba(23, 23, 23, 0.12);
        }

    .btn-barber-submit {
        width: 100%;
        background: #171717;
        color: #ffffff;
        border: none;
        border-radius: 10px;
        padding: 13px 20px;
        font-size: 15px;
        font-weight: 600;
        transition: background-color 0.2s ease, color 0.2s ease;
    }

        .btn-barber-submit:hover {
            background: #c9a227;
            color: #111111;
        }

    .barber-footer-links {
        margin-top: 22px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
    }

    .barber-register-text {
        font-size: 13.5px;
        color: #777777;
        margin: 0;
    }

        .barber-register-text a {
            color: #c9a227;
            font-weight: 700;
            text-decoration: none;
        }

            .barber-register-text a:hover {
                text-decoration: underline;
            }

    .back-home-link {
        font-size: 13.5px;
        font-weight: 600;
        color: #555555;
        text-decoration: none;
        transition: color 0.2s ease;
    }

        .back-home-link:hover {
            color: #171717;
            text-decoration: underline;
        }
</style>

<div class="barber-login-page">
    <div class="barber-login-card text-center">
        <div class="barber-brand-badge">✂</div>
        <h1 class="barber-login-title">Welcome Back</h1>
        <p class="barber-login-subtitle">Login to your GenZCut barber partner account</p>

        @if (TempData["SuccessMsg"] != null)
        {
            <div class="alert alert-success py-2 small text-start rounded-3">
                @TempData["SuccessMsg"]
            </div>
        }

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger py-2 small text-start rounded-3">
                @ViewBag.Error
            </div>
        }

        <form asp-controller="Account" asp-action="BarberLogin" method="post" class="text-start">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email Address</label>
                <input asp-for="Email" class="form-control" placeholder="Enter your email" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="Enter your password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn-barber-submit">
                Login
            </button>
        </form>

        <div class="barber-footer-links">
            <p class="barber-register-text">
                Don't have a barber account?
                <a asp-controller="Account" asp-action="BarberRegister">Create Account</a>
            </p>
            <a asp-controller="Home" asp-action="Index" class="back-home-link">
                ← Back to Home
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}