@model GenZCut.Models.RegisterViewModel

@{
    ViewData["Title"] = "Sign Up";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign Up - GenZCut</title>
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #0f2027 0%, #203a43 50%, #2c5364 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 30px 15px;
            margin: 0;
        }

        .register-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
            overflow: hidden;
            width: 100%;
            max-width: 460px;
            padding: 35px 30px;
            transition: transform 0.3s ease;
        }

        .register-card:hover {
            transform: translateY(-5px);
        }

        .brand-logo {
            width: 65px;
            height: 65px;
            background: linear-gradient(135deg, #ff416c, #ff4b2b);
            color: #fff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            margin: 0 auto 12px auto;
            box-shadow: 0 8px 20px rgba(255, 65, 108, 0.4);
        }

        .form-floating input, .form-select-custom {
            border-radius: 12px;
            border: 1px solid #e0e0e0;
            padding-left: 45px !important;
            height: 52px;
        }

        .form-floating label {
            padding-left: 45px;
        }

        .form-floating input:focus, .form-select-custom:focus {
            border-color: #ff4b2b;
            box-shadow: 0 0 8px rgba(255, 75, 43, 0.25);
        }

        .input-icon {
            position: absolute;
            top: 17px;
            left: 15px;
            z-index: 10;
            color: #888;
            font-size: 16px;
        }

        .btn-custom {
            background: linear-gradient(135deg, #ff416c, #ff4b2b);
            border: none;
            border-radius: 12px;
            color: white;
            font-weight: 600;
            font-size: 16px;
            height: 50px;
            letter-spacing: 0.5px;
            box-shadow: 0 8px 20px rgba(255, 65, 108, 0.3);
            transition: all 0.3s ease;
        }

        .btn-custom:hover {
            background: linear-gradient(135deg, #ff4b2b, #ff416c);
            box-shadow: 0 12px 25px rgba(255, 65, 108, 0.5);
            color: white;
        }

        .footer-text {
            font-size: 13px;
            color: #777;
        }
    </style>
</head>
<body>

    <div class="register-card">
        <!-- Logo Icon -->
        <div class="brand-logo">
            <i class="fa-solid fa-scissors"></i>
        </div>

        <h3 class="text-center fw-bold mb-1" style="color: #2c5364;">GenZCut</h3>
        <p class="text-center text-muted small mb-4">Create your account & get started</p>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-3 text-center py-2 fs-6 mb-3" role="alert">
                <i class="fa-solid fa-triangle-exclamation me-1"></i> @ViewBag.Error
            </div>
        }

        <form asp-action="Register" method="post">
            <!-- Full Name -->
            <div class="form-floating mb-3 position-relative">
                <i class="fa-solid fa-user input-icon"></i>
                <input asp-for="FullName" class="form-control" id="floatingName" placeholder="John Doe" required />
                <label for="floatingName">Full Name</label>
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>

            <!-- Email Address -->
            <div class="form-floating mb-3 position-relative">
                <i class="fa-solid fa-envelope input-icon"></i>
                <input asp-for="Email" class="form-control" id="floatingEmail" placeholder="name@example.com" required />
                <label for="floatingEmail">Email Address</label>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <!-- Phone Number -->
            <div class="form-floating mb-3 position-relative">
                <i class="fa-solid fa-phone input-icon"></i>
                <input asp-for="Phone" class="form-control" id="floatingPhone" placeholder="1234567890" required />
                <label for="floatingPhone">Phone Number</label>
                <span asp-validation-for="Phone" class="text-danger small"></span>
            </div>

            <!-- Password -->
            <div class="form-floating mb-3 position-relative">
                <i class="fa-solid fa-lock input-icon"></i>
                <input asp-for="Password" type="password" class="form-control" id="floatingPassword" placeholder="Password" required />
                <label for="floatingPassword">Password</label>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <!-- Role Selection -->
            <div class="form-floating mb-4 position-relative">
                <i class="fa-solid fa-user-tag input-icon"></i>
                <select asp-for="Role" class="form-select form-select-custom" id="floatingRole" required>
                    <option value="" disabled selected>-- Select Role --</option>
                    <option value="Barber">Barber</option>
                    <option value="Customer">Customer</option>
                    <option value="Admin">Admin</option>
                </select>
                <label for="floatingRole">Register As</label>
                <span asp-validation-for="Role" class="text-danger small"></span>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn btn-custom w-100 mb-3">
                <i class="fa-solid fa-user-plus me-2"></i> Register
            </button>
        </form>

        <div class="text-center mt-2">
            <p class="text-muted small mb-0">Already have an account? <a asp-action="Login" class="fw-bold text-decoration-none" style="color: #ff4b2b;">Log In</a></p>
        </div>

        <div class="text-center footer-text mt-3">
            <p class="mb-0">&copy; 2026 GenZCut Salon Management. All rights reserved.</p>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>