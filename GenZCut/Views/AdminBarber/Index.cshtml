@model IEnumerable<GenZCut.Models.Admin.AdminBarberViewModel>

@{
    ViewData["Title"] = "Manage Barbers";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Manage Barbers</h2>
            <p class="text-muted">View and manage your barber team.</p>
        </div>

        <a asp-controller="AdminBarber"
           asp-action="Create"
           class="btn btn-primary">
            + Add New Barber
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <h5 class="mb-0">Barber List</h5>
        </div>

        <div class="card-body table-responsive">

            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Barber Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Experience</th>
                        <th>Appointments</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var barber in Model)
                        {
                            <tr>
                                <td>@barber.Id</td>
                                <td>@barber.Name</td>
                                <td>@(barber.Email ?? "N/A")</td>
                                <td>@(barber.PhoneNumber ?? "N/A")</td>
                                <td>@barber.Experience years</td>
                                <td>@barber.TotalAppointments</td>

                                <td>
                                    @if (barber.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>

                                <td>
                                    <div class="d-flex gap-1">

                                        <a asp-controller="AdminBarber"
                                           asp-action="Details"
                                           asp-route-id="@barber.Id"
                                           class="btn btn-sm btn-info text-white">
                                            Details
                                        </a>

                                        <a asp-controller="AdminBarber"
                                           asp-action="Edit"
                                           asp-route-id="@barber.Id"
                                           class="btn btn-sm btn-warning">
                                            Edit
                                        </a>

                                        <form asp-controller="AdminBarber"
                                              asp-action="Delete"
                                              asp-route-id="@barber.Id"
                                              method="post"
                                              onsubmit="return confirm('Are you sure you want to delete this barber?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-danger">
                                                Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">
                                No barbers found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>

</div>